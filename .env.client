# Client/local mode — tracked template. Copy nothing; point --env-file at this.
#   docker compose -f docker-compose-client.yml --env-file .env.client up -d
# See docs/LOCAL.md.

# ---- What you must edit ----
# Folder that CONTAINS 0/ (not 0/ itself, not 0/frames).
DATASET_HOST_PATH=/mnt/e/random42/data/aic_2025
LOG_HOST_PATH=./logs
HOST_UID=1000
HOST_GID=1000
# Port the browser opens.
CLIENT_PORT=9080

# ---- Tunnels to the server (see docs/LOCAL.md step 2) ----
# Search backends, reached from inside the hub container via the host.
SIGLIP_V2_HOST_PUBLIC=http://host.docker.internal:9029
UTIL_HOST_PUBLIC=http://host.docker.internal:9025
# The server's media nginx, for video only. Frames are local.
VIDEO_UPSTREAM=http://host.docker.internal:9028
RESULT_MANAGER_UPSTREAM=http://host.docker.internal:9022

# ---- Media paths: relative, so one origin serves everything ----
# Do not make these absolute: they end up in URLs the browser fetches.
NGINX_IMAGE_HOST=/media/frames
NGINX_VIDEO_HOST=/media/clips

# ---- Hub ----
HUB_HOST=0.0.0.0
HUB_PORT=9021
HUB_MAX_WORKERS=4
BASE_URL=/
REQUEST_TIMEOUT=60
TIMEOUT_KEEP_ALIVE=30
ENABLE_GZIP=true
SERVICE=hub

# ---- Dataset path prefixes ----
# String prefixes only: the hub builds an absolute path then relpaths it against
# the same prefix, so it cancels out and only "0/frames/..." reaches the
# browser. Your real location is the DATASET_HOST_PATH mount above.
BASE_PATH=data
DATASET_PATH_ORIGIN=data/original
DATASET_PATH_TEAM=data
KEYFRAME_FOLDER_PATH=data
SPLIT_NAME=low_res_autoshot
SPLIT_NAME_LOW_RES=low_res_autoshot
LOWRES_FORMAT=.avif
DATASET_INDEX=data/index

# These may dangle in client mode: the hub never opens them, the server's
# services read them and send back results.
S2T_PATH=[]
FPS_PATH=[]
SHOT_PATH=[]
OBJECT_PATH=

# ---- Unused locally, but Settings expects them ----
RESULT_MANAGER_HOST=0.0.0.0
RESULT_MANAGER_PORT=9022
RESULT_MANAGER_MAX_WORKERS=1
SIGLIP_V2_B_HOST_PUBLIC=http://host.docker.internal:9030
METACLIP_HOST_PUBLIC=http://host.docker.internal:9031
RERANK_HOST_PUBLIC=http://host.docker.internal:9126
SUBMISSION_HOST_PUBLIC=http://host.docker.internal:9024
TRANSFORMERS_CACHE=/app/model-cache/hub
LOG_DIR=logs/
