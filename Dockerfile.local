# Local image for the `hub` gateway ONLY. hub is a pure HTTP proxy in front of the
# GPU-heavy services (CLIP models, Qdrant) and the rest of the backend, which run via
# Dockerfile.server / docker-compose-server.yml (on a server with a GPU). No CUDA/torch here.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SERVICE=hub

WORKDIR /app

COPY requirements-local.txt .
RUN pip install --no-cache-dir -r requirements-local.txt

COPY . .

# Keep the hub on its configured port.  `src.main` also owns lifecycle handling.
CMD ["python", "-m", "src.main"]
