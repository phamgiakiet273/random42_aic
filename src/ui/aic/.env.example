# All of these are OPTIONAL. By default the SPA talks to its own origin and the
# Vite dev server (:10000) proxies /hub, /submission, /result_manager and /media
# to the backend (see vite.config.js), so the browser only ever needs one port.
# In docker-compose-local.yml these are set for you.

# Where the dev server forwards to (defaults: this machine's published ports).
# VITE_PROXY_HUB=http://127.0.0.1:9021          # /hub and /submission (hub forwards /submission)
# VITE_PROXY_MEDIA=http://127.0.0.1:9027        # /media/frames + /media/clips
# VITE_PROXY_RESULT_MANAGER=http://127.0.0.1:9022
# VITE_ALLOWED_HOSTS=localhost,<this machine's hostname>,.ts.net

# Serve media from another origin instead of /media (rarely needed).
# VITE_MEDIA_BASE_URL=http://<host>:9027/media

# Bypass the proxy and call absolute backend origins instead (needs CORS and each
# of those ports reachable from the browser -- the proxy above is the normal path).
# VITE_API_BASE_URL=http://<host>:9021
# VITE_RESULT_MANAGER_BASE_URL=http://<host>:9022
