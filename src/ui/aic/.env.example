# All of these are OPTIONAL. By default the SPA talks to its own origin and the
# Vite dev server proxies /hub, /img, /video and /result_manager to the backend
# (see vite.config.js). That keeps remote access working over a single port.

# Where the dev server forwards to. Change these if the backend is not on this
# machine, or is on non-default ports.
# VITE_PROXY_HUB=http://127.0.0.1:9021
# VITE_PROXY_MEDIA=http://127.0.0.1:9027
# VITE_PROXY_RESULT_MANAGER=http://127.0.0.1:9022

# Bypass the proxy and call an absolute backend origin instead (needs CORS and
# every one of those ports reachable from the browser).
# VITE_API_BASE_URL=http://100.84.93.96:9021
# VITE_RESULT_MANAGER_BASE_URL=http://100.84.93.96:9022
# VITE_MEDIA_BASE_URL=http://100.84.93.96:9027
